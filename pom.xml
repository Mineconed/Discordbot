<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dk.mineconed</groupId>
    <artifactId>Discordbot</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Discordbot</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Spigot 1.8.8 -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>net.md-5</groupId>
                    <artifactId>bungeecord-chat</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- Discord (JDA) bliver pakket med i jar filen -->
        <dependency>
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>5.2.1</version>
            <exclusions>
                <exclusion>
                    <groupId>club.minnced</groupId>
                    <artifactId>opus-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>Discordbot</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>8</release>
                </configuration>
            </plugin>
            <!-- Pakker JDA ind i jar filen og flytter den, så den ikke støder sammen med andre plugins -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation><pattern>net.dv8tion</pattern><shadedPattern>dk.mineconed.discordbot.lib.jda</shadedPattern></relocation>
                                <relocation><pattern>okhttp3</pattern><shadedPattern>dk.mineconed.discordbot.lib.okhttp3</shadedPattern></relocation>
                                <relocation><pattern>okio</pattern><shadedPattern>dk.mineconed.discordbot.lib.okio</shadedPattern></relocation>
                                <relocation><pattern>kotlin</pattern><shadedPattern>dk.mineconed.discordbot.lib.kotlin</shadedPattern></relocation>
                                <relocation><pattern>com.fasterxml</pattern><shadedPattern>dk.mineconed.discordbot.lib.fasterxml</shadedPattern></relocation>
                                <relocation><pattern>com.neovisionaries</pattern><shadedPattern>dk.mineconed.discordbot.lib.ws</shadedPattern></relocation>
                                <relocation><pattern>gnu.trove</pattern><shadedPattern>dk.mineconed.discordbot.lib.trove</shadedPattern></relocation>
                                <relocation><pattern>org.apache.commons.collections4</pattern><shadedPattern>dk.mineconed.discordbot.lib.collections4</shadedPattern></relocation>
                                <relocation><pattern>org.slf4j</pattern><shadedPattern>dk.mineconed.discordbot.lib.slf4j</shadedPattern></relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
